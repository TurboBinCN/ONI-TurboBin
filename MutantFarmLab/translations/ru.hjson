{
  STRINGS: {
    BUILDINGS: {
      PREFABS: {
        MUTANTFARMLAB: {
          NAME: Мутационная лаборатория
          DESC: Высокотехнологичная лаборатория, потребляющая радиационные частицы. Позволяет направленно мутировать обычные семена в редкие мутированные сорта.
          EFFECT: Потребляет радиационные частицы для направленной мутации семян растений
        }
        CUSTOMRADIATIONLIGHT: {
          NAME: Радиационная лента
          DESC: Работает на запасённых радиационных частицах. Создаёт радиационную среду для роста мутированных растений. Можно регулировать уровень мощности, чтобы менять интенсивность излучения.
          EFFECT: Обеспечивает радиацию в широком диапазоне за счёт внутренних запасов частиц
          LOW_PARTICLE_SIGNAL: Сигнал «мало частиц»
          LOW_PARTICLE_SIGNAL_TOOLTIP: Срабатывает, когда запас частиц падает ниже порога запуска
          LOGIC_PORT_STORAGE: Состояние запаса частиц
          LOGIC_PORT_STORAGE_ACTIVE: Запас недостаточен
          LOGIC_PORT_STORAGE_INACTIVE: Запас в норме
        }
        RADIATIONPARTICLEADAPTER: {
          NAME: Адаптер радиационных частиц
          DESC: Автоматизированный модуль, крепится непосредственно к фермерской плитке или гидропонике. Принимает высокоэнергетические частицы и направленно облучает растения, ускоряя мутацию.
          EFFECT: Направленно облучает растения в фермерской плитке/гидропонике за счёт внутренних запасов частиц
          LOGIC_PORT_NAME: Сигнал «мало частиц»
          LOGIC_PORT_ACTIVE: Запас частиц недостаточен — требуется пополнение
          LOGIC_PORT_INACTIVE: Запас частиц в норме — работает штатно
          WARNING_NO_FARMTILE: Нет привязанной фермерской плитки
          WARNING_NO_FARMTILE_TOOLTIP: Первый блок модуля должен быть размещён вплотную к фермерской плитке или гидропонике!
          WARNING_LOW_PARTICLE: Недостаток радиационных частиц
          WARNING_LOW_PARTICLE_TOOLTIP: Недостаточное поступление частиц — облучение приостановлено. Проверьте генератор частиц.
        }
        RADIATIONFARMTILE: {
          NAME: Радиационная фермерская плитка
          DESC: Создаёт радиационную среду для растений, посаженных сверху
          EFFECT: Постоянно облучает растение сверху, расходуя урановую руду
          LOW_URANIUMORE: Низкий запас урановой руды
          LOW_URANIUMORE_TOOLTIP: Недостаточно урановой руды — облучение невозможно.
        }
      }
    }

    UI: {
      UISIDESCREENS: {
        PLANTERSIDESCREEN: {
          PLANT: Растение
        }
        MUTANTFARMLAB: {
          TITLE: Панель мутации семян
          NONE_DISCOVERED: Ни одно семя ещё не открыто
          SELECT_SEEDS: Выберите семена для мутации
          SEED_FORBIDDEN: Запрещённые семена
          SEED_ALLOWED: Разрешённые семена
          SEED_NO_MUTANTS: Нет доступных мутаций
          FILTER_CATEGORY: Семена для обработки
        }
        SLIDERCONTROL: {
          TITLE: Настройка мощности облучения
          DESC: Регулирует уровень радиации и одновременно скорость расхода частиц
          TOOLTIP: Чем выше мощность — тем сильнее радиация и быстрее расход частиц
          ANOTHER_PLANT: Дочернее растение
        }
      }

      NOTIFICATIONS: {
        MUTANTFARM_NEED_MATERIALS: {
          NAME: Невозможно начать мутацию
          TOOLTIP: Требования: здание подключено к энергии + есть семена в хранилище + ≥10 радиационных частиц
        }
      }

      UNITSUFFIXES: {
        RADIATION: {
          SETTING_RAD_LEVEL: Уровень радиации
          RADLEVEL: Уровень радиации
        }
      }

      TASKS: {
        CANCEL_REASONS: {
          STORAGE_FULL: Хранилище заполнено
          DESTROYED: Задача уничтожена
        }
      }

      STATUSITEMS: {
        NEEDPARTICLES: {
          NAME: Недостаточно радиационных частиц
          TOOLTIP: Для мутации семян требуется {0} радиационных частиц на каждое семя
        }
        CONSUMERATEURANIUMORE: {
          NAME: Расход урановой руды: {0} г/с
          TOOLTIP: Скорость расхода урановой руды радиационной плиткой: {0} г/с
        }
        CONSUMERATEPARTICLES: {
          NAME: Расход радиационных частиц: {0}/с
          TOOLTIP: Скорость расхода частиц зданием: {0}/с
        }
      }

      OPTIONS: {
        GROUP_MUTANT_PLANT: Мутантные растения
        OPTION_DUAL_HEAD_NAME: Двухголовая мутация
        OPTION_DUAL_HEAD_DESC: Включает двухголовую мутацию растений, у растений есть шанс мутировать в двухголовую форму
        OPTION_ACTINO_NAME: Мутация актиномицетов
        OPTION_ACTINO_DESC: Включает мутацию актиномицетов, растения могут расти при низком освещении и низком количестве питательных веществ
        OPTION_OILENRICH_NAME: Обогащение нефтью
        OPTION_OILENRICH_DESC: Включает мутацию обогащения нефтью, растения могут производить нефть
        OPTION_RADSEED_NAME: Радиационные семена
        OPTION_RADSEED_DESC: Включает мутацию радиационных семян, семена получают устойчивость к радиации
      }
    }

    ELEMENT: {
      RADSEED: {
        NAME: Радиосемя
        DESC: Особое семя с высокой устойчивостью к радиации. При съедании полностью выводит радиацию из организма и даёт временный иммунитет к облучению.
      }
      DULHEAD: {
        NAME: "Двуглавый куст"
        DESC: "Растение развило двойную структуру: два независимых ростовых ядра в одной клетке. Делят условия посадки, но созревают отдельно. Урожай с одного ядра чуть ниже, зато сильно экономится место. При высоком качестве каждое ядро даёт свои семена."
      }
      ACTINO: {
        NAME: "Актиномицет"
        DESC: "Радиационно-стимулированный гриб-мутант. Обладает тремя полезными свойствами: очищает от микробов, даёт мягкое свечение, экономит воду и удобрения. Использует радиацию для уничтожения патогенов вокруг себя, освещает растения, сильно снижает потребление ресурсов. Минусы: очень долгий рост и слабое излучение радиации в окружающую среду."
      }
      OILENRICH: {
        NAME: "Нефтеобогатитель"
        DESC: "Промышленный мутант для радиационных ферм. Эффективно поглощает CO₂ и превращает его в нефть — ключевой элемент цикла «углерод → нефть → энергия». Требует радиационной среды для работы. В паре с актиномицетом обеспечивает самоосвещение и очистку от микробов. Минусы: повышенный расход удобрений и удлинённый цикл роста. Идеален для крупных поздних баз."
      }
    }

    ITEMS: {
      FOOD: {
        RADSEED: {
          NAME: "Радиосемя"
          DESC: "Светящееся семя. При употреблении мгновенно выводит всю радиацию из организма и даёт временную защиту от облучения."
        }
      }
    }

    DUPLICANTS: {
      MODIFIERS: {
        RADCLEAR: {
          NAME: "Очищение от радиации"
          DESCRIPTION: "Вся накопленная радиация мгновенно удалена из организма."
        }
        RADIMMUNITY: {
          NAME: "Иммунитет к радиации"
          DESCRIPTION: "Полная невосприимчивость к радиационному урону в течение 5 циклов."
        }
      }
    }

    MUTANTS: {
      EFFECTS: {
        DUAL_HEAD_SYMBIOSIS: {
          NAME: "Симбиоз двойного ядра"
          DESC: "Два ядра двуглавого куста делят одну клетку и условия роста. Урожай с одного ядра немного ниже.\nБонусы симбиоза:\n-50% потребности в удобрениях\n+70% общего урожая\nсредневзвешенный цикл роста"
        }
      }
    }
  }
}