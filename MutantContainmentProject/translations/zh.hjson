    ENTITY: {
      MUTANTER: {
        MUTANTER_SCP173: {
          NAME: <link="MUTANTER_SCP173">SCP-173</link>
          DESCRIPTION: 1993 年转移至 19 号站点。起源未知。主体由混凝土与钢筋构成，表面残留有 Krylon 牌喷漆痕迹。SCP-173 具备活动性且极度敌对。
        }
        MUTANTER_SCP096: {
          NAME: <link="MUTANTER_SCP096">SCP-096</link>
          DESCRIPTION: 一种类人生物，身高约2.38米。肌肉量极少，初步体重分析显示存在轻度营养不良。手臂与身体比例严重失调，每只手臂长约1.5米。皮肤几乎完全缺乏色素，体表无毛发。
        }
        MUTANTER_SCP662: {
          NAME: <link="MUTANTERSCP662">SCP-662</link>
          DESCRIPTION: SCP-662是一枚外观普通的银色小铃铛，尺寸与标准服务铃一致。摇动铃铛后，会召唤出一名自称为“杰拉尔德先生（Mr. Gerald）”的男性实体。
        }
        MUTANTER_SCP662_1: {
          NAME: <link="MUTANTER_SCP662_1">SCP-662-1</link>
          DESCRIPTION: SCP-662-1是由SCP-662召唤出的男性实体，自称为“杰拉尔德先生”。它外观为中年白人男性，身着黑色燕尾服与白手套，言行举止符合传统英式管家形象。
        }
        MUTANTER_SCP049: {
          NAME: <link="MUTANTER_SCP049">SCP-049</link>
          DESCRIPTION: SCP-049是一个人形实体，身高约1.9米，外形与中世纪瘟疫医生一致。其看似穿着厚重长袍与标志性陶瓷鸟嘴面具，但这些衣物并非穿戴，而是从其体内生长而出，现已与本体几乎无法区分。
        }
        MUTANTER_SCP049_2: {
          NAME: <link="MUTANTER_SCP049_2">SCP-049-2</link>
          DESCRIPTION: SCP-049-2是SCP-049手术改造后的活尸化实体，无自主意识，仅服从SCP-049指令，对非SCP-049的人类具攻击性。
        }
        MUTANTER_SCP939: {
          NAME: <link="MUTANTER_SCP939">SCP-939</link>
          DESCRIPTION: SCP-939是温血群居掠食生物，呈现典型穴居生物的系统退化特征，常潜藏于阴暗区域伏击猎物。
        }
        MUTANTER_SCP4762: {
          NAME: <link="MUTANTER_SCP4762">SCP-4762</link>
          DESCRIPTION: SCP-4762是一种类人雪人异常实体，由致密积雪、冰晶与未知低温有机纤维构成。它被动释放超低温寒气，受到威胁时会主动投射高密度低温冰块。
        }
        MUTANTER_DAWN_CONFUSION: {
          NAME: <link="MUTANTER_DAWN_CONFUSION">黎明的疑惑</link>
          DESCRIPTION: 黎明的疑惑是一种在昼夜交界时出现的异常实体。它会释放一种混乱的气场，影响周围生物对时间和空间的感知，导致混乱和迷失方向。
        }
        MUTANTER_BUG_DUSK: {
          NAME: <link="MUTANTER_BUG_DUSK">糯虫</link>
          DESCRIPTION: 糯虫是一种蠕虫状生物，口部长着尖牙，背上长有较薄的褐色甲壳，身体两侧还生长着一些琥珀色的泡状物体。它会在走廊里徘徊，当有单位靠近时，会通过跳起撕咬的方式发起攻击。
        }
      }
    }
    RESEARCH: {
      TREES: {
        TITLE_MUTANT_CONTAINMENT: 畸变体收容
      }
      TECHS: {
        MUTANT_CONTAINMENT: {
          NAME: 畸变体收容
          DESC: 研究收容和管理异常实体的技术
