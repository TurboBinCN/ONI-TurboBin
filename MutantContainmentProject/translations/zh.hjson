          NAME: 基础畸变体收容
          DESC: 解锁基础的收容设施，用于收容畸变体实体
        }
        MUTANT_CONTAINMENT_ADVANCED: {
          NAME: 进阶畸变体收容
          DESC: 解锁进阶的收容设施，用于收容畸变体实体
        }
      }
    }
    CODEX: {
      STORY_TRAITS: {
        CLOSE_BUTTON: 关闭
        MUTANTER_FOUNDER: {
          NAME: 畸变源核祭坛遗迹
          DESCRIPTION: 深埋异星地下的古老遗迹，承载着未知文明的畸变研究痕迹，核心蕴含强烈的畸变能量，是畸变体诞生的源头，需通过献祭与特定条件解锁，唤醒其中封存的独特畸变体。
          END_POPUP: {
            NAME:剧情特质完成：畸变源核祭坛遗迹
            CODEX_NAME:仪式完成
            DESCRIPTION:"成功！畸变体祭坛已完成全部校准。\n\n现在可引导畸变体的不稳定能量，改变其物理特性。\n\n警告：过度使用会导致祭坛进入敌对状态，引发不可预知的突变。"
            BUTTON:解锁祭坛操控模式
          }
          BEGIN_POPUP: {
            NAME: 剧情特质：畸变源核祭坛遗迹
            CODEX_NAME: 发现祭坛
            DESCRIPTION: "我发现了一座浸染着畸变体残余能量的古老祭坛。\n\n完成足够校准后，可利用它操控这些生物的基因不稳定性。\n\n但其能量极不稳定——务必极度谨慎操作。"
          }
          UNLOCK_SPECIES_NOTIFICATION: {
            NAME: 畸变体已出现
            TOOLTIP: "畸变源核祭坛遗迹 已发现以下畸变体变体：\n"
          }
          UNLOCK_SPECIES_POPUP: {
            NAME: 畸变体已出现
            TOOLTIP: "查看畸变体数据"
          }
          SPECIES_ENTRIES: {
            MUTANTER_SCP173: 样本试图干扰祭坛能量核心。查看数据了解更多信息。
            MUTANTER_SCP096: 样本在祭坛激活时表现出极度痛苦。查看数据了解更多信息。
            MUTANTER_SCP662: 样本显现为一个银色铃铛，可召唤出类似管家的实体。该实体表现温顺但需要监控。
            MUTANTER_DAWN_CONFUSION: 样本显现为一个半透明的人形轮廓，会扭曲时间和空间感知。查看数据了解更多信息。
            MUTANTER_BUG_DUSK: 样本显现为一个蠕虫状生物，长有尖牙和褐色甲壳。它在接近时表现出攻击行为。查看数据了解更多信息。
            UNKNOWN_TITLE: 祭坛控制系统警告
            UNKNOWN: "祭品已成功处理。\n\n因能量波动故障，突变功能暂时不可用。\n\n请注意：踢击祭坛外壳无法修复此问题，还可能对能量矩阵造成永久性损坏。"
          }
          SPECIES_ENTRIES_EXPANDED: {
            MUTANTER_SCP173: "样本试图突破祭坛能量核心外壳。样本状态可用，但收容装置已出现一定程度的损毁。\n\n对撞击痕迹的原子力显微镜分析显示存在针铁矿痕迹——这种矿物以极高的强度和对畸变体不稳定能量的亲和性著称。"
            MUTANTER_SCP096: "样本在暴露于祭坛能量信号时表现出严重的情绪痛苦。受试者变得高度攻击性并试图突破收容。\n\n神经分析显示杏仁核和前额叶皮层活动异常，表明祭坛能量频率触发了过度活跃的恐惧反应。"
            MUTANTER_SCP662: "样本显现为一个具有异常属性的小银铃。摇动时，会召唤出一个自称为'杰拉尔德先生'的类人生物，其外观为传统英国管家。\n\n该实体对摇铃者完全服从，可在合理范围内执行各种任务。它无法被常规手段伤害，完成任务或被 dismissal 后会消失。\n\n能量分析表明，铃铛作为连接到一个额外维度平面的通道，管家实体从该平面被召唤而来。连接似乎稳定，但需要进一步研究。"
            MUTANTER_DAWN_CONFUSION: "样本显现为一个半透明的人形轮廓，周围环绕着微弱的光晕。它释放一种混乱的气场，影响周围生物对时间和空间的感知。\n\n初步分析显示，该实体在黎明和黄昏时分活动最为活跃，此时其混乱气场的影响范围会扩大。它没有明显的攻击性，但长期暴露可能导致永久性的空间感知障碍。\n\n能量读数表明，该实体的异常属性与昼夜交界有关，暗示着与时间转换的联系。"
            MUTANTER_BUG_DUSK: "样本显现为一个蠕虫状生物，长有尖牙和薄褐色甲壳。身体两侧有琥珀色的泡状生长物。\n\n该实体表现出领地行为，在走廊中巡逻并攻击任何接近的单位。它使用跳跃咬击攻击，造成1-2点物理伤害并移动到目标身后。\n\n分析表明，它对低等级人员表现出高度攻击性，并且经常成群行动。一旦发起攻击，它会持续追击目标。其身体上的琥珀色生长物似乎是一种防御机制，可能含有粘性物质。\n\n能量读数表明，该生物对黑暗、封闭的空间有强烈的偏好，这可能解释了它对走廊环境的偏好。"
          }
        }
      }
      MUTANTER: {
        MUTANTER_SCP173: {
          TITLE: SCP-173 雕像
          SUBTITLE: SCP-173 雕像
          BODY: {
            CONTAINER1: "项目编号：SCP-173\n项目等级：Euclid（欧几里得）\n特殊收容措施：SCP-173 必须始终存放于上锁容器内。人员必须进入其收容间时，任何时候不得少于三人，且进入后立即重新锁门。在所有人员撤离并重新锁门前，必须有两人持续与 SCP-173 保持直接视线接触。\n描述：1993 年转移至 19 号站点。起源未知。主体由混凝土与钢筋构成，表面残留有 Krylon 牌喷漆痕迹。SCP-173 具备活动性且极度敌对。\n该物体在被直接注视时无法移动，视线绝对不可中断。进入收容间的人员必须互相提醒后再眨眼。\n其攻击方式为折断目标颈骨底部或勒颈。遇袭时，人员需执行 4 级危险物品收容程序。\n无人在收容间内时，内部会传来石头刮擦的声响，此为正常现象；若该行为出现异常，需立即上报当班高级监管人员。\n地板上的红棕色物质是粪便与血液的混合物，来源不明。地板上始终留有三双脚印，尺寸固定，从未被观测到移动或改变。\n附录 173-01：禁止人员携带任何记录设备进入 SCP-173 收容间。任何在收容间内制作的录音、录像均须立即销毁。此命令自【数据删除】事件后生效。"
          }
        }
        MUTANTER_SCP096: {
          TITLE: "SCP-096 The \"害羞的人\""
          SUBTITLE: "SCP-096 The \"害羞的人\""
          BODY: {
            CONTAINER1: "项目编号：SCP-096 害羞的人\n项目等级：Euclid（欧几里得）\n特殊收容措施：SCP-096 必须被持续收容于一间 5m × 5m × 5m 的钢制气密立方体隔间内。每周必须检查隔间是否存在裂缝或孔洞。SCP-096 的隔间内严禁安装任何视频监控或光学观测设备。安保人员仅可通过预先安装的压力传感器与激光探测器确认 SCP-096 是否在隔间内。\n未经 ███ 博士与 O5-█ 许可，严禁拍摄、录制或制作任何 SCP-096 的照片、视频或肖像。Description：\nSCP-096 是一具身高约 2.38 米 的类人生物。其肌肉量极少，初步体重分析显示存在轻度营养不良。手臂与身体比例严重失调，每只手臂长约 1.5 米。皮肤几乎完全缺乏色素，体表无毛发。\nSCP-096 的下颌可张开至普通人类的 4 倍。除眼睛同样缺乏色素外，其余面部特征与普通人类相似。目前尚不清楚 SCP-096 是否失明。它未表现出任何高级脑功能，不被认为具有自我意识。\nSCP-096 平时极度温顺，隔间内的压力传感器显示它大部分时间都在东墙附近踱步。然而，当任何生物看到它的脸—— 无论是直接目视、通过视频录像，甚至是照片 —— 它会立即进入极度情绪痛苦状态：用手捂住脸，开始尖叫、哭泣、胡言乱语。在首次被看到后的 1–2 分钟 内，SCP-096 会开始冲向看到它脸的个体（以下称为 SCP-096-1）。\n已记录的速度范围为 35 km/h 至 ███ km/h，似乎与 SCP-096-1 的距离相关。目前没有任何已知材料或方法能阻止 SCP-096 的行进。SCP-096-1 的实际位置似乎不影响 SCP-096 的反应；它似乎拥有对 SCP-096-1 位置的先天感知能力。注意：观看艺术创作的画像不会触发反应（见文档 096-1）。\n抵达 SCP-096-1 位置后，SCP-096 会杀死并 [数据删除] SCP-096-1。所有案例均未留下 SCP-096-1 的任何痕迹。随后 SCP-096 会静坐数分钟，恢复镇静并再次变得温顺，然后尝试返回其自然栖息地 [数据编辑]。\nAddenda\n附录 096-1\n测试记录：\n测试 096-1： D-9031 观看 SCP-096 照片。SCP-096 进入痛苦状态，突破收容并处决 D-9031。\n测试 096-2： D-9032 观看 SCP-096 艺术画作。无反应。\n测试 096-3： D-9033 观看 SCP-096 脸部低分辨率像素化图像。SCP-096 反应并处决 D-9033。\n事件 096-1-A\n日期： ██/██/████\n地点： 研究区 ██\n概要： 安保摄像头画面意外显示在公共监视器上，导致 SCP-096 突破收容。SCP-096 行进 ██ 公里，杀死 ██ 名人员后被重新收容。所有包含 SCP-096 脸部的录像均已销毁。"
          }
        }
        MUTANTER_SCP662: {
          TITLE: "SCP-662 管家铃"
          SUBTITLE: "SCP-662 管家铃"
          BODY: {
            CONTAINER1: "项目编号：SCP-662\n项目等级：Safe（安全）\n特殊收容措施：SCP-662应存放于Site-19的标准低危物品储物柜中。任何人员在使用前需提交正式申请，并在使用期间接受至少一名二级安保人员的监视。\n描述：\nSCP-662是一枚外观普通的银色小铃铛，尺寸与标准服务铃一致。摇动铃铛后，会召唤出一名自称为“杰拉尔德先生（Mr. Gerald）”的男性实体。\n杰拉尔德先生外貌为中年白人男性，身着黑色燕尾服与白手套，言行举止符合传统英式管家形象。他会对摇铃者表现出绝对顺从，能够在合理范围内完成绝大多数指令，包括但不限于：准备餐食、整理环境、提供信息、执行简单任务、处理日常琐事等。\n该实体无法被常规手段伤害或消灭，任务完成或被要求离开后便会消失。其能力存在明确限制：无法违背物理定律、无法直接伤害他人、无法实现超出常理的愿望、无法执行自杀性或高度危险指令。\nSCP-662本身不会损坏，但其召唤出的管家实体仅对当前摇铃者负责，新的使用者会覆盖之前的指令权限。"
          }
        }
        MUTANTER_SCP662_1: {
          TITLE: "SCP-662-1 杰拉尔德先生"
          SUBTITLE: "SCP-662-1 杰拉尔德先生"
          BODY: {
            CONTAINER1: "项目编号：SCP-662-1\n项目等级：Safe（安全）\n特殊收容措施：SCP-662-1不需要特定的收容措施，因为它只会在SCP-662被摇动时出现，并在完成任务或被 dismissal 后消失。\n描述：\nSCP-662-1是由SCP-662召唤出的男性实体，自称为“杰拉尔德先生”。它外观为中年白人男性，身着黑色燕尾服与白手套，言行举止符合传统英式管家形象。\nSCP-662-1对SCP-662的摇铃者表现出绝对顺从，能够在合理范围内完成绝大多数指令，包括但不限于：准备餐食、整理环境、提供信息、执行简单任务、处理日常琐事等。\n该实体无法被常规手段伤害或消灭，任务完成或被要求离开后便会消失。其能力存在明确限制：无法违背物理定律、无法直接伤害他人、无法实现超出常理的愿望、无法执行自杀性或高度危险指令。\nSCP-662-1仅对当前SCP-662的摇铃者负责，新的使用者会覆盖之前的指令权限。"
          }
        }
        MUTANTER_SCP049: {
          TITLE: "SCP-049 瘟疫医生"
          SUBTITLE: "SCP-049 瘟疫医生"
          BODY: {
            CONTAINER1: "项目编号：SCP-049\n项目等级：Euclid（欧几里得）\n特殊收容措施：SCP-049 被收容于 Site-19 研究区 - 02 的标准安全收容间内。所有与 SCP-049 的互动必须由至少两名 4 级安保人员监督。任何情况下，禁止与 SCP-049 发生皮肤接触。若 SCP-049 表现出敌意或试图突破收容，应立即启动收容间的镇静气体系统，并派遣 MTF Gamma-12（“剪刀手”）进行重新收容。\n描述：\nSCP-049 是一个人形实体，身高约 1.9 米，外形与中世纪瘟疫医生一致。其看似穿着厚重长袍与标志性陶瓷鸟嘴面具，但这些衣物并非穿戴，而是从其体内生长而出，现已与本体几乎无法区分。X 光显示其表层下存在类人骨骼结构。\nSCP-049 可使用多种语言交流，偏好英语或中世纪法语。通常对基金会人员友善、配合，但感知到其所谓 \"瘟疫（Pestilence）\" 时会变得易怒、具攻击性。\n对其认定 \"感染瘟疫\" 者，会产生敌意并试图杀死对方：皮肤接触可瞬间终止生物所有生理机能，机制不明，尸检无结论。\n杀人后常表现沮丧 / 悔恨，称此举对消灭 \"瘟疫\" 作用甚微；随后会用随身黑色医疗包内工具对尸体进行粗糙手术，常产生 SCP-049-2 实例（活尸化产物）。\nSCP-049 坚信自身在 \"治愈\" 瘟疫，但其对 \"瘟疫\" 的定义与基金会认知完全不同，且拒绝详细解释。"
          }
        }
        MUTANTER_SCP049_2: {
          TITLE: "SCP-049-2 活尸"
          SUBTITLE: "SCP-049-2 活尸"
          BODY: {
            CONTAINER1: "项目编号：SCP-049-2\n项目等级：Euclid（欧几里得）\n特殊收容措施：SCP-049-2 实例不需要特殊收容措施。\n描述：\nSCP-049-2 指的是经 SCP-049 手术改造后的活尸化实体。它们自带一次性蓄电池（180 千焦），在电池耗尽前可以工作 10 周期。\nSCP-049-2 实例具有异常生理机能，无需营养或氧气即可在电池寿命内持续工作。\n当蓄电池耗尽后，SCP-049-2 实例会停机，此时可以被复制人拆除回收。"
          }
        }
        MUTANTER_SCP939: {
          TITLE: "SCP-939 千喉之兽"
          SUBTITLE: "SCP-939 千喉之兽"
          BODY: {
            CONTAINER1: "项目编号：SCP-939\n项目等级：Keter（极高危险、极难收容）\n类型：温血群居掠食生物，呈现典型穴居生物的系统退化特征，适配《缺氧》地底密闭生态环境，常潜藏于阴暗区域伏击猎物\n常见别名：千喉之兽\n生理外观\n1. 体型：直立平均高2.2米，重250千克；四肢带三指利爪+可对握第四指，覆有强攀爬力的刚毛，能灵活穿梭于《缺氧》基地的管道、岩壁及狭窄空间，适配纵向地底环境。\n2. 头部与感官：头部细长，无眼/眼眶/脑壳；下颚有6厘米长、微弱红光的尖牙，带热感应颊窝，可精准捕捉复制人散发的体温信号；背部带刺脊线分布可感知明暗的眼斑，16厘米长的背刺还能察觉气压与气流变化，对《缺氧》基地内的气体流动（如氧气泄漏、二氧化碳堆积）异常敏感；极度畏强光，暴露在基地照明或自然光下会出现躁动、逃窜行为。\n3. 特殊生理：缺少中枢神经、循环、消化道；呼吸系统仅用于释放记忆消除气雾（AMN-C227）；无进食刚需，吞入物（包括复制人遗体、基地废料）会在呼吸腔堆积后被吐出；仍能胎生繁殖，目前未发现雄性个体，繁殖过程无需消耗额外资源，适配《缺氧》生物生存的资源循环逻辑。\n异常能力\n1. 完美声音模仿：核心狩猎手段，能精准复制过往受害者的人声（甚至未听过对方讲话也能模仿），常以痛苦呼救、哀求、求助维修基地设备等贴合《缺氧》复制人日常的话术诱骗；声纹与真人完全一致，无法通过任何基地检测手段辨别真伪，因此会持续吸引附近的复制人前往其藏匿区域，一旦靠近便会发动攻击，对基地人员安全造成极大威胁。\n2. 强力咬合与捕猎：咬合力超35MPa，常一口咬穿复制人颅骨/脖颈致死；群体协作捕猎，擅长利用《缺氧》基地的复杂地形（如管道缝隙、废弃舱室、岩壁凹陷）埋伏，会优先攻击单独行动、脱离群体的复制人，避免与多名复制人正面冲突。\n3. AMN-C227记忆消除气雾：呼吸释放无色无味的C级遗忘剂，造成顺行性失忆（暴露期+后续约30分钟无法形成新记忆）；复制人脱离气雾环境后，在一周期内（贴合《缺氧》游戏内“周期”计时单位，与复制人代谢、睡眠周期同步）会无征兆进入沉睡状态，沉睡期间无法执行任何工作指令，且会失去对SCP-939的相关记忆，苏醒后仍可能被其声音模仿再次诱骗，同时沉睡状态会降低复制人体力恢复效率，增加基地生存压力。\n- 历史事件：\n曾发生“平安夜”收容突破，9只个体逃逸至基地深层区域，大量复制人被其声音诱骗，出现伤亡及沉睡现象，导致基地氧气循环、资源采集工作停滞；基金会以“基地内部气体泄漏”为由启动应急封锁，疏散受影响区域的复制人，并派武装回收队完成收容。\n- AMN-C227曾一度被考虑量产为通用遗忘剂，用于消除复制人对基地事故的不良记忆，后因多次引发复制人无征兆沉睡、工作系统瘫痪等事故，被无限期停用。\n- 游戏表现：适配《缺氧》生存逻辑，是基地深层区域的高危敌对生物，常潜藏于黑暗的岩壁或废弃舱室，通过模仿复制人声音干扰基地运营，其释放的记忆消除气雾会导致复制人工作中断，沉睡状态还会占用基地医疗资源，给玩家的基地管理带来极大挑战。"
          }
        }
        MUTANTER_SCP4762: {
          TITLE: "SCP-4762 极地守夜雪人"
          SUBTITLE: "SCP-4762 极地守夜雪人"
          BODY: {
            CONTAINER1: "项目编号：SCP-4762\n项目等级：Safe（安全）\n特殊收容措施：SCP-4762收容于Site-19极地分区Cold-7低温人形收容单元，环境恒定-35℃、95%湿度，模拟北极永久冻土，配备双层防冰裂墙体、低温冷凝回收系统与冰屑收集装置，严禁明火、高温设备及强光源入内。单元外围设三级隔离屏障，搭载热成像、声波、温度异常预警及低温稳定系统，每日补充积雪冰体。仅允许2级及以上人员穿戴特级抗寒防护服进入，单次接触不超过15分钟。严禁暴力抓捕、强光、噪音、肢体束缚等行为；禁止携带利器、热武器及人类文明标识物品。项目躁动时立即启动沟通安抚预案，严禁压迫手段；其释放的低温冰块禁止擅自触碰，静待自然消散。\n描述：\nSCP-4762为类人雪人异常实体，高约2.8米，通体由致密积雪、冰晶与未知低温有机纤维构成，覆白色绒毛，面部无五官，仅存深色感知凹陷。体重恒定350kg，核心体温-42℃，接触常温物体即刻结霜，≥80℃高温可造成不可逆损伤。\n项目具备自主意识，无语言能力，可通过肢体、冰痕、积雪图案传递情绪，无主动攻击性，仅在受威胁、领地被侵时进入防御状态。可在极地暴风雪中自由行动，操控积雪筑盾，移动无声。\n核心异常能力：可被动释放-50℃至-70℃超低温寒气，情绪波动时主动投射高密度低温冰块；平静期仅散微量寒气与冰屑，防御期冰块射程5-8米，仅针对威胁目标，触碰可致瞬间深度冻伤。\n发现与背景：\n2023年12月于格陵兰岛北极冻土带发现，当地因纽特部落奉其为“冰雪守灵”，世代供奉。史料记载其存在超300年，为极地自然异常，以冰体冰封破坏者、守护冻土生态为职责，从未伤及部落族人。\n初期收容采用压迫手段，触发项目防御机制，造成人员冻伤、设备冻裂，后续全面改用温和收容策略。观测证实，其冰体释放行为均源于安全感缺失，对善意互动有正向反馈。"
          }
        }
        MUTANTER_DAWN_CONFUSION: {
          TITLE: "黎明的疑惑"
          SUBTITLE: "黎明的疑惑"
          BODY: {
            CONTAINER1: "项目编号：黎明的疑惑\n项目等级：Euclid（欧几里得）\n特殊收容措施：黎明的疑惑应被收容在一个光线可控的收容室内，模拟昼夜交替的环境。收容室应配备情绪监测设备和空间感知测试装置，以追踪其异常能力的影响范围。人员进入收容室前必须佩戴情绪稳定器和空间定位装置，避免受到其混乱气场的影响。\n描述：\n黎明的疑惑是一种在昼夜交界时出现的异常实体，外形呈现为半透明的人形轮廓，身体周围环绕着微弱的光晕。它的存在会扭曲周围的时间和空间感知，导致进入其影响范围的生物产生混乱、迷失方向和时间感知错乱的症状。\n该实体主要在黎明和黄昏时分活动最为活跃，此时其混乱气场的影响范围会扩大。它没有明显的攻击性，但长期暴露在其影响下可能导致永久性的空间感知障碍。\n核心异常能力：释放混乱气场，影响周围生物对时间和空间的感知，导致方向迷失和时间错乱。在昼夜交界时能力最强，影响范围最大。\n发现与背景：\n该实体首次于2024年3月在一处废弃的研究设施中被发现，当时研究人员报告了严重的空间感知混乱和时间错觉现象。初步收容尝试因人员迷失方向而失败，后通过建立光线控制的收容环境成功将其稳定收容。"
          }
        }
        MUTANTER_BUG_DUSK: {
          TITLE: "糯虫"
          SUBTITLE: "糯虫"
          BODY: {
            CONTAINER1: "项目编号：糯虫\n项目等级：Euclid（欧几里得）\n特殊收容措施：糯虫应被收容在一个加固的收容室内，墙壁应光滑以防止其攀爬。收容室应配备运动传感器和安全摄像头。人员应避免单独进入收容室，因为糯虫通常成群狩猎。\n描述：\n糯虫是一种蠕虫状生物，口部长着尖牙，背上长有较薄的褐色甲壳，身体两侧还生长着一些琥珀色的泡状物体。它会在走廊里徘徊，当有单位靠近时，会通过跳起撕咬的方式发起攻击，造成1-2点物理伤害并移动到目标身后。\n这些生物对低等级人员构成重大威胁。它们通常成群行动，一旦发起攻击就会持续追击目标。\n核心异常能力：糯虫表现出增强的跳跃能力和持续追击的特性。当它攻击时，会移动到目标身后，使多人攻击时难以防御。\n发现与背景：\n糯虫是在一处废弃研究设施的黑暗走廊中被发现的。它们似乎是该设施下层区域的原生生物，已经适应了狭窄的空间。它们的行为表明它们是群体猎手，会协调攻击。"
          }
        }
      }
    }
  }
}