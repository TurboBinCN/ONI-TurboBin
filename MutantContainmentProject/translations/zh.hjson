        CLOSE_BUTTON: 关闭
        MUTANTER_FOUNDER: {
          NAME: 畸变源核祭坛遗迹
          DESCRIPTION: 深埋异星地下的古老遗迹，承载着未知文明的畸变研究痕迹，核心蕴含强烈的畸变能量，是畸变体诞生的源头，需通过献祭与特定条件解锁，唤醒其中封存的独特畸变体。
          END_POPUP: {
            NAME:剧情特质完成：畸变源核祭坛遗迹
            CODEX_NAME:仪式完成
            DESCRIPTION:"成功！畸变体祭坛已完成全部校准。\n\n现在可引导畸变体的不稳定能量，改变其物理特性。\n\n警告：过度使用会导致祭坛进入敌对状态，引发不可预知的突变。"
            BUTTON:解锁祭坛操控模式
          }
          BEGIN_POPUP: {
            NAME: 剧情特质：畸变源核祭坛遗迹
            CODEX_NAME: 发现祭坛
            DESCRIPTION: "我发现了一座浸染着畸变体残余能量的古老祭坛。\n\n完成足够校准后，可利用它操控这些生物的基因不稳定性。\n\n但其能量极不稳定——务必极度谨慎操作。"
          }
          UNLOCK_SPECIES_NOTIFICATION: {
            NAME: 畸变体已出现
            TOOLTIP: "畸变源核祭坛遗迹 已发现以下畸变体变体：\n"
          }
          UNLOCK_SPECIES_POPUP: {
            NAME: 畸变体已出现
            TOOLTIP: "查看畸变体数据"
          }
          SPECIES_ENTRIES: {
            MUTANTER_SCP173: 样本试图干扰祭坛能量核心。查看数据了解更多信息。
            MUTANTER_SCP096: 样本在祭坛激活时表现出极度痛苦。查看数据了解更多信息。
            MUTANTER_SCP662: 样本显现为一个银色铃铛，可召唤出类似管家的实体。该实体表现温顺但需要监控。
            UNKNOWN_TITLE: 祭坛控制系统警告
            UNKNOWN: "祭品已成功处理。\n\n因能量波动故障，突变功能暂时不可用。\n\n请注意：踢击祭坛外壳无法修复此问题，还可能对能量矩阵造成永久性损坏。"
          }
          SPECIES_ENTRIES_EXPANDED: {
            MUTANTER_SCP173: "样本试图突破祭坛能量核心外壳。样本状态可用，但收容装置已出现一定程度的损毁。\n\n对撞击痕迹的原子力显微镜分析显示存在针铁矿痕迹——这种矿物以极高的强度和对畸变体不稳定能量的亲和性著称。"
            MUTANTER_SCP096: "样本在暴露于祭坛能量信号时表现出严重的情绪痛苦。受试者变得高度攻击性并试图突破收容。\n\n神经分析显示杏仁核和前额叶皮层活动异常，表明祭坛能量频率触发了过度活跃的恐惧反应。"
            MUTANTER_SCP662: "样本显现为一个具有异常属性的小银铃。摇动时，会召唤出一个自称为'杰拉尔德先生'的类人生物，其外观为传统英国管家。\n\n该实体对摇铃者完全服从，可在合理范围内执行各种任务。它无法被常规手段伤害，完成任务或被 dismissal 后会消失。\n\n能量分析表明，铃铛作为连接到一个额外维度平面的通道，管家实体从该平面被召唤而来。连接似乎稳定，但需要进一步研究。"
          }
        }
      }
      MUTANTER: {
        MUTANTER_SCP173: {
          TITLE: SCP-173 雕像
          SUBTITLE: SCP-173 雕像
          BODY: {
            CONTAINER1: "项目编号：SCP-173\n项目等级：Euclid（欧几里得）\n特殊收容措施：SCP-173 必须始终存放于上锁容器内。人员必须进入其收容间时，任何时候不得少于三人，且进入后立即重新锁门。在所有人员撤离并重新锁门前，必须有两人持续与 SCP-173 保持直接视线接触。\n描述：1993 年转移至 19 号站点。起源未知。主体由混凝土与钢筋构成，表面残留有 Krylon 牌喷漆痕迹。SCP-173 具备活动性且极度敌对。\n该物体在被直接注视时无法移动，视线绝对不可中断。进入收容间的人员必须互相提醒后再眨眼。\n其攻击方式为折断目标颈骨底部或勒颈。遇袭时，人员需执行 4 级危险物品收容程序。\n无人在收容间内时，内部会传来石头刮擦的声响，此为正常现象；若该行为出现异常，需立即上报当班高级监管人员。\n地板上的红棕色物质是粪便与血液的混合物，来源不明。地板上始终留有三双脚印，尺寸固定，从未被观测到移动或改变。\n附录 173-01：禁止人员携带任何记录设备进入 SCP-173 收容间。任何在收容间内制作的录音、录像均须立即销毁。此命令自【数据删除】事件后生效。"
          }
        }
        MUTANTER_SCP096: {
          TITLE: "SCP-096 The \"害羞的人\""
          SUBTITLE: "SCP-096 The \"害羞的人\""
          BODY: {
            CONTAINER1: "项目编号：SCP-096 害羞的人\n项目等级：Euclid（欧几里得）\n特殊收容措施：SCP-096 必须被持续收容于一间 5m × 5m × 5m 的钢制气密立方体隔间内。每周必须检查隔间是否存在裂缝或孔洞。SCP-096 的隔间内严禁安装任何视频监控或光学观测设备。安保人员仅可通过预先安装的压力传感器与激光探测器确认 SCP-096 是否在隔间内。\n未经 ███ 博士与 O5-█ 许可，严禁拍摄、录制或制作任何 SCP-096 的照片、视频或肖像。Description：\nSCP-096 是一具身高约 2.38 米 的类人生物。其肌肉量极少，初步体重分析显示存在轻度营养不良。手臂与身体比例严重失调，每只手臂长约 1.5 米。皮肤几乎完全缺乏色素，体表无毛发。\nSCP-096 的下颌可张开至普通人类的 4 倍。除眼睛同样缺乏色素外，其余面部特征与普通人类相似。目前尚不清楚 SCP-096 是否失明。它未表现出任何高级脑功能，不被认为具有自我意识。\nSCP-096 平时极度温顺，隔间内的压力传感器显示它大部分时间都在东墙附近踱步。然而，当任何生物看到它的脸—— 无论是直接目视、通过视频录像，甚至是照片 —— 它会立即进入极度情绪痛苦状态：用手捂住脸，开始尖叫、哭泣、胡言乱语。在首次被看到后的 1–2 分钟 内，SCP-096 会开始冲向看到它脸的个体（以下称为 SCP-096-1）。\n已记录的速度范围为 35 km/h 至 ███ km/h，似乎与 SCP-096-1 的距离相关。目前没有任何已知材料或方法能阻止 SCP-096 的行进。SCP-096-1 的实际位置似乎不影响 SCP-096 的反应；它似乎拥有对 SCP-096-1 位置的先天感知能力。注意：观看艺术创作的画像不会触发反应（见文档 096-1）。\n抵达 SCP-096-1 位置后，SCP-096 会杀死并 [数据删除] SCP-096-1。所有案例均未留下 SCP-096-1 的任何痕迹。随后 SCP-096 会静坐数分钟，恢复镇静并再次变得温顺，然后尝试返回其自然栖息地 [数据编辑]。\nAddenda\n附录 096-1\n测试记录：\n测试 096-1： D-9031 观看 SCP-096 照片。SCP-096 进入痛苦状态，突破收容并处决 D-9031。\n测试 096-2： D-9032 观看 SCP-096 艺术画作。无反应。\n测试 096-3： D-9033 观看 SCP-096 脸部低分辨率像素化图像。SCP-096 反应并处决 D-9033。\n事件 096-1-A\n日期： ██/██/████\n地点： 研究区 ██\n概要： 安保摄像头画面意外显示在公共监视器上，导致 SCP-096 突破收容。SCP-096 行进 ██ 公里，杀死 ██ 名人员后被重新收容。所有包含 SCP-096 脸部的录像均已销毁。"
          }
        }
        MUTANTER_SCP662: {
          TITLE: "SCP-662 管家铃"
          SUBTITLE: "SCP-662 管家铃"
          BODY: {
            CONTAINER1: "项目编号：SCP-662\n项目等级：Safe（安全）\n特殊收容措施：SCP-662应存放于Site-19的标准低危物品储物柜中。任何人员在使用前需提交正式申请，并在使用期间接受至少一名二级安保人员的监视。\n描述：\nSCP-662是一枚外观普通的银色小铃铛，尺寸与标准服务铃一致。摇动铃铛后，会召唤出一名自称为“杰拉尔德先生（Mr. Gerald）”的男性实体。\n杰拉尔德先生外貌为中年白人男性，身着黑色燕尾服与白手套，言行举止符合传统英式管家形象。他会对摇铃者表现出绝对顺从，能够在合理范围内完成绝大多数指令，包括但不限于：准备餐食、整理环境、提供信息、执行简单任务、处理日常琐事等。\n该实体无法被常规手段伤害或消灭，任务完成或被要求离开后便会消失。其能力存在明确限制：无法违背物理定律、无法直接伤害他人、无法实现超出常理的愿望、无法执行自杀性或高度危险指令。\nSCP-662本身不会损坏，但其召唤出的管家实体仅对当前摇铃者负责，新的使用者会覆盖之前的指令权限。"
          }
        }
        MUTANTER_SCP662_1: {
          TITLE: "SCP-662-1 杰拉尔德先生"
          SUBTITLE: "SCP-662-1 杰拉尔德先生"
          BODY: {
            CONTAINER1: "项目编号：SCP-662-1\n项目等级：Safe（安全）\n特殊收容措施：SCP-662-1不需要特定的收容措施，因为它只会在SCP-662被摇动时出现，并在完成任务或被 dismissal 后消失。\n描述：\nSCP-662-1是由SCP-662召唤出的男性实体，自称为“杰拉尔德先生”。它外观为中年白人男性，身着黑色燕尾服与白手套，言行举止符合传统英式管家形象。\nSCP-662-1对SCP-662的摇铃者表现出绝对顺从，能够在合理范围内完成绝大多数指令，包括但不限于：准备餐食、整理环境、提供信息、执行简单任务、处理日常琐事等。\n该实体无法被常规手段伤害或消灭，任务完成或被要求离开后便会消失。其能力存在明确限制：无法违背物理定律、无法直接伤害他人、无法实现超出常理的愿望、无法执行自杀性或高度危险指令。\nSCP-662-1仅对当前SCP-662的摇铃者负责，新的使用者会覆盖之前的指令权限。"
          }
        }
      }
    }
  }
}