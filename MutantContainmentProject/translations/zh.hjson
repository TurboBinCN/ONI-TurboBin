    BUILDINGS: {
      PREFABS: {
        GRAVITASMUTANTERFOUNDER: {
          NAME: 畸变源核祭坛遗迹
          DESC: 深埋异星地下的古老遗迹，承载着未知文明的畸变研究痕迹，核心蕴含强烈的畸变能量，是畸变体诞生的源头，需通过献祭与特定条件解锁，唤醒其中封存的独特畸变体。
          EFFECT: 作为畸变体的诞生源头，提供独特的畸变体诞生机制和特殊的环境效果。
        }
        CONTAINMENTMONITORSTATION: {
          NAME: 畸变体监控站
          DESC: 用于监控畸变体，并进行相应的安全控制措施，防止畸变体突破收容
          EFFECT: 在畸变体收容所内，对畸变体进行安全防治。
        }
        CONTAINMENTTILE: {
          NAME: 中子质收容护壁
          DESC: 由中子质锻造而成的强化护壁，构成畸变体收容室的核心结构屏障。可抵御物理突破，并抑制收容实体释放的不稳定能量。
          EFFECT: 为畸变体收容室内的畸变体提供无法穿透的物理收容防护与能量抑制效果。
        }
      }
      STATUSITEMS: {
        GRAVITAS_MUTANTER_FOUNDER_COOLDOWN: {
            NAME: "正在献祭 {percent}"
            TOOLTIP: "祭坛正在献祭 剩余:{timeleft}"
        }
        GRAVITASMUTANTERFOUNDERPROGRESS: {
            NAME: "已收集畸变体数据 {0}/{1}"
            TOOLTIP: "该祭坛需要收集多种 <style=\"KKeyword\">畸变体</style> 的能量特征，才能解锁突变操控功能\n\n已分析的畸变体："
            NO_DATA: 未分析任何畸变体
        }
        GRAVITASMUTANTERFOUNDERMORPHMODELOCKED: {
            NAME: 当前状态：封印中
            TOOLTIP: "该祭坛需收集更多 <style=\"KKeyword\">畸变体</style> 能量特征才能激活"
        }
        GRAVITASMUTANTERFOUNDERMORPHMODE: {
            NAME: 当前状态：激活中
            TOOLTIP: "该祭坛已就绪，可操控 <style=\"KKeyword\">畸变体</style> 的突变形态"
        }
        GRAVITASMUTANTERFOUNDERWAITING: {
            NAME: 等待祭品
            TOOLTIP: "该祭坛正在等待 <style=\"KKeyword\">祭品</style> 进行献祭"
        }
        GRAVITASMUTANTERFOUNDERWORKING: {
            NAME: 汲取祭品能量
            TOOLTIP: "该祭坛正在从 <style=\"KKeyword\">祭品</style> 中汲取不稳定能量，用以生成畸变体"
        }
      }
      NOTIFICATIONS: {
        GRAVITASMUTANTERFOUNDER: {
            NAME: 畸变体已存在
            TOOLTIP: "该畸变体 {0} 已经存在于世界中，无法重复生成。"
        }
      }
